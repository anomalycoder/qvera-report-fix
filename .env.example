# ==============================================================================
# QVERA Report -> Fix Engine — Environment Variable Template
# Copy to `.env` (or `backend/.env` for backend-only runs) and set production values.
# NEVER commit real API keys, tokens, or secrets into version control.
# ==============================================================================

# Application Identity & Runtime
PROJECT_NAME="QVERA Report -> Fix Engine"
API_V1_STR="/api/v1"
ENV="development"
HOST="0.0.0.0"
PORT=8000

# SQLite WAL Persistence Path / Database URI
DATABASE_URL="sqlite:///./acadza.db"

# Allowed Frontend Origins (JSON array or comma-separated list in production)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
# Optional regex to match preview deployments (e.g. Vercel previews)
CORS_ALLOW_ORIGIN_REGEX=""

# Seeded Evaluation Accounts Flag (set false in locked-down non-demo deployments)
ALLOW_DEMO_AUTH=true

# Optional External LLM Provider (provider-independent; runs deterministically with SymPy without external key)
LLM_PROVIDER="provider_independent"
LLM_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# Frontend API Base URL:
# - Leave empty in local dev so Vite proxies `/api/*` to http://127.0.0.1:8000
# - Set in Vercel production to your deployed FastAPI backend URL (no trailing slash), e.g. https://qvera-api.onrender.com
VITE_API_BASE_URL=""
